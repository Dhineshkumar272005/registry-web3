DEPLOYER_KEY=            # testnet-only private key, never a real wallet
AMOY_RPC=                # optional dedicated RPC (Alchemy/Infura) for scale
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_RPC=         # optional read RPC
DATABASE_URL=            # dedicated Postgres for user information only (Supabase/Neon/RDS)
DATA_KEY=                # 64 hex chars: openssl rand -hex 32
JWT_SECRET=              # openssl rand -hex 32
DEPLOY_BLOCK=0           # block where the contract was deployed (speeds up event reads)
# --- deployment identity and release gate (NEXT_PUBLIC_* are fixed at build time) ---
NEXT_PUBLIC_ENV=staging            # set to production only when every item below is true
NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CHAIN_ID_HEX=          # e.g. 0x89 for Polygon PoS; your permissioned chain id otherwise
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_CHAIN_SYMBOL=
NEXT_PUBLIC_CHAIN_SHORT=
NEXT_PUBLIC_EXPLORER=
NEXT_PUBLIC_AUDIT_URL=             # published independent audit report (https)
NEXT_PUBLIC_LEGAL_REVIEWED=false   # true only after counsel approves the policies
NEXT_PUBLIC_LEGAL_UPDATED=
NEXT_PUBLIC_CONTENT_REVIEWED=false # true only after clinician review of the disease text
# --- scaling ---
CRON_TOKEN=                        # 32+ characters, shared with the indexer worker
DB_POOL_MAX=5                      # per replica
TRUST_PROXY_HOPS=1                 # proxies in front of the app; 0 ignores X-Forwarded-For
INDEXER_CONFIRMATIONS=12           # use 0 only on a local test chain
# RATE_LIMIT_DISABLED=true         # load testing on staging only
# --- keys, administration ---
DATA_KEYS=                         # id:64hex entries, newest first, e.g. 2:...,1:...  (replaces DATA_KEY)
ADMIN_WALLETS=                     # comma-separated administrator wallet addresses
